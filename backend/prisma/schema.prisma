generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum WalletChain {
  EVM
  SOLANA
}

enum VerificationState {
  UNVERIFIED
  PENDING_MANUAL
  VERIFIED
  FAILED
}

enum ApplicationStatus {
  PENDING
  VERIFIED
  REJECTED
  WITHDRAWN
}

enum SubmissionKind {
  ONE_OF_ONE
  TRAIT_EXTENSION
}

enum GeneratorCategory {
  BACKGROUND
  FUR
  EYES
  EARS
  TAILS
  MASKS
  HATS
  SPECIAL
}

enum SubmissionStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  GALLERY_ADDED
  WITHDRAWN
}

enum VoteValue {
  UP
  DOWN
}

enum RestrictionType {
  VOTE
  SUBMISSION
  ACCOUNT
}

enum GalleryEntryKind {
  ONE_OF_ONE
  TRAIT
}

enum PublicationState {
  GALLERY_ONLY
  ONCHAIN_EXTENSION
}

enum AccrualStatus {
  ACCRUED
  APPROVED
  PAID
  VOID
}

enum PayoutStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

enum MonitorDirection {
  INCOMING
  OUTGOING
  BOTH
}

enum MonitorCadence {
  CONTINUOUS
  DAILY
  WEEKLY
}

enum AgentNotificationType {
  PAYMENT_RECEIVED
  PAYMENT_SENT
  PAYMENT_LATE
  MONITOR_ERROR
}

enum ConversationRole {
  USER
  ASSISTANT
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AgentActionType {
  AWAKEN
  SET_EXECUTION_PAUSED
  UPDATE_AGENT_URI
  SEND_NATIVE_USDC
  GRANT_CHECKPOINT_SESSION
  REVOKE_CHECKPOINT_SESSION
}

enum AgentActionStatus {
  PREPARED
  SUBMITTED
  CONFIRMED
  FAILED
  EXPIRED
  UNKNOWN
}

enum SponsorshipReservationStatus {
  RESERVED
  ATTACHED
  SETTLED
  EXPIRED
  RELEASED
  FAILED
  VOID
}

model User {
  id                      String                   @id @default(cuid())
  role                    Role                     @default(USER)
  displayName             String?
  avatarUrl               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  socialAccounts          SocialAccount[]
  sessions                Session[]
  wallets                 Wallet[]
  applications            Application[]
  drafts                  Draft[]
  submissions             Submission[]
  votes                   Vote[]
  voteEvents              VoteEvent[]
  restrictions            VoteRestriction[]
  riskEvents              RiskEvent[]
  statusEventsAuthored    SubmissionStatusEvent[]  @relation("StatusEventActor")
  adminAudits             AdminAuditLog[]          @relation("AdminAuditActor")
  idempotencyRecords      IdempotencyRecord[]
  payouts                 Payout[]
  walletSessions          WalletSession[]
  monitorRules            MonitorRule[]
  agentNotifications      AgentNotification[]
  conversations           Conversation[]
  usageMeters             UsageMeter[]
  modelDataConsents       ModelDataConsent[]
  agentActions            AgentAction[]
  sponsorshipReservations SponsorshipReservation[]
}

model SocialAccount {
  id                String            @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  username          String
  claimKey          String?           @unique
  verificationState VerificationState @default(UNVERIFIED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([provider, username])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Wallet {
  id                      String                   @id @default(cuid())
  userId                  String
  chain                   WalletChain
  address                 String
  normalized              String
  isPrimary               Boolean                  @default(false)
  verifiedAt              DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications            Application[]
  feeShares               FeeShare[]
  payouts                 Payout[]
  walletSessions          WalletSession[]
  monitorRules            MonitorRule[]
  ownershipPeriods        OwnershipPeriod[]
  modelDataConsents       ModelDataConsent[]
  agentActions            AgentAction[]
  sponsorshipReservations SponsorshipReservation[]

  @@unique([chain, normalized])
  @@index([userId])
}

model ChainCursor {
  id                String    @id @default(cuid())
  chainId           Int
  collectionAddress String
  stream            String
  nextBlock         BigInt
  lastBlockHash     String?
  lastError         String?
  lastErrorAt       DateTime?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@unique([chainId, collectionAddress, stream])
}

model ChainEvent {
  id                String    @id @default(cuid())
  chainId           Int
  collectionAddress String
  txHash            String
  logIndex          Int
  transactionIndex  Int
  blockNumber       BigInt
  blockHash         String
  eventName         String
  tokenId           String
  fromAddress       String
  toAddress         String
  blockTime         DateTime?
  indexedAt         DateTime  @default(now())

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, collectionAddress, tokenId, blockNumber])
  @@index([chainId, collectionAddress, toAddress, blockNumber])
}

model OwnershipPeriod {
  id                      String                   @id @default(cuid())
  chainId                 Int
  collectionAddress       String
  tokenId                 String
  sequence                Int
  ownerAddress            String
  walletId                String?
  startedBlock            BigInt
  startedTxHash           String
  startedLogIndex         Int
  startedAt               DateTime?
  endedBlock              BigInt?
  endedTxHash             String?
  endedLogIndex           Int?
  endedAt                 DateTime?
  createdAt               DateTime                 @default(now())
  wallet                  Wallet?                  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  conversations           Conversation[]
  modelDataConsents       ModelDataConsent[]
  agentActions            AgentAction[]
  sponsorshipReservations SponsorshipReservation[]

  @@unique([chainId, collectionAddress, tokenId, sequence])
  @@index([chainId, collectionAddress, tokenId, endedBlock])
  @@index([ownerAddress, endedBlock])
  @@index([walletId, endedBlock])
}

model AgentAction {
  id                        String                  @id @default(cuid())
  userId                    String
  walletId                  String
  ownershipPeriodId         String
  chainId                   Int
  collectionAddress         String
  tokenId                   String
  accountAddress            String
  type                      AgentActionType
  status                    AgentActionStatus       @default(PREPARED)
  senderAddress             String
  targetAddress             String
  transactionValueBaseUnits Decimal                 @db.Decimal(78, 0)
  assetAmountBaseUnits      Decimal?                @db.Decimal(78, 0)
  callData                  String
  calldataHash              String
  payload                   Json
  sourceBlock               BigInt
  expiresAt                 DateTime
  txHash                    String?
  submittedAt               DateTime?
  receiptBlock              BigInt?
  receiptBlockHash          String?
  failureCode               String?
  confirmedAt               DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  user                      User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet                    Wallet                  @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ownershipPeriod           OwnershipPeriod         @relation(fields: [ownershipPeriodId], references: [id], onDelete: Restrict)
  sponsorshipReservation    SponsorshipReservation?

  @@unique([chainId, txHash])
  @@index([userId, tokenId, createdAt])
  @@index([walletId, status, createdAt])
  @@index([ownershipPeriodId, createdAt])
  @@index([status, expiresAt])
}
model SponsorshipReservation {
  id                      String                       @id @default(cuid())
  userId                  String
  walletId                String
  ownershipPeriodId       String
  agentActionId           String?                      @unique
  chainId                 Int
  collectionAddress       String
  tokenId                 String
  accountAddress          String
  actionType              AgentActionType
  status                  SponsorshipReservationStatus @default(RESERVED)
  currency                String                       @default("USDC")
  gasAsset                String                       @default("native-USDC")
  dailyBucket             DateTime
  dailyAllowanceBaseUnits Decimal                      @db.Decimal(78, 0)
  dailyTransactionLimit   Int
  reservedCostBaseUnits   Decimal                      @db.Decimal(78, 0)
  actualCostBaseUnits     Decimal?                     @db.Decimal(78, 0)
  reservationKey          String                       @unique
  userOperationHash       String?                      @unique
  userOperationNonce      String?
  txHash                  String?
  receiptBlock            BigInt?
  receiptBlockHash        String?
  failureCode             String?
  expiresAt               DateTime
  settledAt               DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  user                    User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet                  Wallet                       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ownershipPeriod         OwnershipPeriod              @relation(fields: [ownershipPeriodId], references: [id], onDelete: Restrict)
  agentAction             AgentAction?                 @relation(fields: [agentActionId], references: [id], onDelete: SetNull)

  @@index([chainId, collectionAddress, tokenId, dailyBucket, status])
  @@index([walletId, status, expiresAt])
  @@index([userId, createdAt])
  @@index([status, expiresAt])
}

model Conversation {
  id                String                @id @default(cuid())
  userId            String
  ownershipPeriodId String
  title             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownershipPeriod   OwnershipPeriod       @relation(fields: [ownershipPeriodId], references: [id], onDelete: Restrict)
  messages          ConversationMessage[]
  toolRuns          ToolRun[]

  @@index([userId, ownershipPeriodId, updatedAt])
}

model ConversationMessage {
  id                 String           @id @default(cuid())
  conversationId     String
  role               ConversationRole
  content            String
  status             AgentRunStatus   @default(COMPLETED)
  sources            Json?
  providerResponseId String?
  inputTokens        Int?
  outputTokens       Int?
  errorCode          String?
  createdAt          DateTime         @default(now())
  conversation       Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  toolRuns           ToolRun[]

  @@index([conversationId, createdAt])
}

model ToolRun {
  id             String              @id @default(cuid())
  conversationId String
  messageId      String
  toolName       String
  status         AgentRunStatus      @default(RUNNING)
  output         Json?
  errorCode      String?
  startedAt      DateTime            @default(now())
  completedAt    DateTime?
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([conversationId, startedAt])
  @@index([messageId])
}

model UsageMeter {
  id           String   @id @default(cuid())
  userId       String
  day          DateTime
  requestCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([day])
}

model ModelDataConsent {
  id                String          @id @default(cuid())
  userId            String
  walletId          String
  ownershipPeriodId String
  provider          String
  modelName         String
  destinationOrigin String
  disclosureVersion Int             @default(1)
  acceptedAt        DateTime        @default(now())
  revokedAt         DateTime?
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  ownershipPeriod   OwnershipPeriod @relation(fields: [ownershipPeriodId], references: [id], onDelete: Restrict)

  @@unique([userId, ownershipPeriodId, provider, disclosureVersion])
  @@index([walletId, revokedAt])
}

model MonitorRule {
  id                String              @id @default(cuid())
  userId            String
  walletId          String
  chainId           Int
  collectionAddress String
  tokenId           String
  watchedAddress    String
  direction         MonitorDirection    @default(INCOMING)
  counterparty      String?
  minimumAmount     Decimal             @default(0) @db.Decimal(78, 0)
  expectedAmount    Decimal?            @db.Decimal(78, 0)
  cadence           MonitorCadence      @default(CONTINUOUS)
  timezone          String              @default("UTC")
  graceMinutes      Int                 @default(60)
  nextExpectedAt    DateTime?
  cursorBlock       BigInt
  isActive          Boolean             @default(true)
  lastCheckedAt     DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  matches           MonitorMatch[]
  notifications     AgentNotification[]

  @@index([userId, isActive])
  @@index([walletId, isActive])
  @@index([chainId, collectionAddress, tokenId])
}

model ObservedPayment {
  id            String              @id @default(cuid())
  chainId       Int
  txHash        String
  logIndex      Int
  fromAddress   String
  toAddress     String
  amount        Decimal             @db.Decimal(78, 0)
  blockNumber   BigInt
  blockTime     DateTime?
  observedAt    DateTime            @default(now())
  matches       MonitorMatch[]
  notifications AgentNotification[]

  @@unique([chainId, txHash, logIndex])
  @@index([chainId, toAddress, blockNumber])
  @@index([chainId, fromAddress, blockNumber])
}

model MonitorMatch {
  monitorRuleId     String
  observedPaymentId String
  direction         MonitorDirection
  createdAt         DateTime         @default(now())
  monitorRule       MonitorRule      @relation(fields: [monitorRuleId], references: [id], onDelete: Cascade)
  observedPayment   ObservedPayment  @relation(fields: [observedPaymentId], references: [id], onDelete: Restrict)

  @@id([monitorRuleId, observedPaymentId])
  @@index([observedPaymentId])
}

model AgentNotification {
  id                String                @id @default(cuid())
  userId            String
  monitorRuleId     String?
  observedPaymentId String?
  type              AgentNotificationType
  title             String
  body              String
  data              Json?
  deliveryKey       String                @unique
  readAt            DateTime?
  createdAt         DateTime              @default(now())
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitorRule       MonitorRule?          @relation(fields: [monitorRuleId], references: [id], onDelete: SetNull)
  observedPayment   ObservedPayment?      @relation(fields: [observedPaymentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([monitorRuleId, createdAt])
}

model WalletChallenge {
  id          String    @id @default(cuid())
  address     String
  normalized  String
  chainId     Int
  nonceHash   String
  messageHash String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([normalized, expiresAt])
  @@index([expiresAt])
}

model WalletSession {
  id         String    @id @default(cuid())
  userId     String
  walletId   String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet     Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([expiresAt])
}

model Application {
  id                  String            @id @default(cuid())
  userId              String            @unique
  walletId            String
  quotePostUrl        String
  quotePostId         String?           @unique
  likedState          VerificationState @default(PENDING_MANUAL)
  repostedState       VerificationState @default(PENDING_MANUAL)
  commentedState      VerificationState @default(PENDING_MANUAL)
  quoteOwnershipState VerificationState @default(PENDING_MANUAL)
  builderTraits       Json
  previewAssetUrl     String?
  status              ApplicationStatus @default(PENDING)
  submittedAt         DateTime          @default(now())
  reviewedAt          DateTime?
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet              Wallet            @relation(fields: [walletId], references: [id])

  @@unique([quotePostUrl])
  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model Draft {
  id               String          @id @default(cuid())
  userId           String
  kind             SubmissionKind
  title            String
  schemaVersion    Int             @default(1)
  version          Int             @default(1)
  generatorVersion String
  payload          Json
  previewAssetUrl  String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions        DraftRevision[]

  @@index([userId, updatedAt])
}

model DraftRevision {
  id        String   @id @default(cuid())
  draftId   String
  version   Int
  payload   Json
  createdAt DateTime @default(now())
  draft     Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, version])
}

model Submission {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  userId           String
  kind             SubmissionKind
  title            String
  titleClaim       String?                 @unique
  description      String
  generatorVersion String
  categories       GeneratorCategory[]
  pixelData        Json
  pixelDataKey     String?                 @unique
  sourceHash       String?
  compatibility    Json?
  mediaHash        String
  previewAssetUrl  String
  previewAssetKey  String?                 @unique
  previewVariants  Json?
  storageProvider  String                  @default("DATABASE")
  canonicalDataKey String?
  canonicalHash    String?
  sourcePostUrl    String?
  status           SubmissionStatus        @default(PENDING)
  publishedAt      DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  upvoteCount      Int                     @default(0)
  downvoteCount    Int                     @default(0)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes            Vote[]
  voteEvents       VoteEvent[]
  statusEvents     SubmissionStatusEvent[]
  accessories      SubmissionAccessory[]
  galleryEntry     GalleryEntry?

  @@unique([userId, mediaHash])
  @@index([status, publishedAt])
  @@index([kind, publishedAt])
  @@index([userId, kind, status])
}

model SubmissionAccessory {
  id             String            @id @default(cuid())
  submissionId   String
  category       GeneratorCategory
  name           String
  normalizedName String
  createdAt      DateTime          @default(now())
  submission     Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([category, normalizedName])
  @@index([submissionId])
}

model SubmissionStatusEvent {
  id           String            @id @default(cuid())
  submissionId String
  actorId      String?
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus
  note         String?
  createdAt    DateTime          @default(now())
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor        User?             @relation("StatusEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([submissionId, createdAt])
}

model Vote {
  id           String             @id @default(cuid())
  submissionId String
  userId       String
  value        VoteValue
  category     GeneratorCategory?
  categoryKey  String             @default("ONE_OF_ONE")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId, categoryKey])
  @@index([userId, updatedAt])
  @@index([submissionId, category, value])
}

model VoteEvent {
  id           String             @id @default(cuid())
  submissionId String
  userId       String
  fromValue    VoteValue?
  toValue      VoteValue?
  category     GeneratorCategory?
  signalHash   String
  requestId    String
  createdAt    DateTime           @default(now())
  submission   Submission         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([signalHash, createdAt])
  @@index([submissionId, category, createdAt])
}

model VoteRestriction {
  id         String          @id @default(cuid())
  userId     String
  type       RestrictionType @default(VOTE)
  reasonCode String
  note       String?
  startsAt   DateTime        @default(now())
  expiresAt  DateTime
  liftedAt   DateTime?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model RiskEvent {
  id         String   @id @default(cuid())
  userId     String?
  signalHash String
  eventType  String
  score      Int
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([signalHash, createdAt])
  @@index([userId, createdAt])
}

model GalleryEntry {
  id               String              @id @default(cuid())
  submissionId     String              @unique
  kind             GalleryEntryKind
  publicationState PublicationState    @default(GALLERY_ONLY)
  categories       GeneratorCategory[]
  displayOrder     Int                 @default(0)
  isVisible        Boolean             @default(true)
  tokenChainId     Int?
  tokenContract    String?
  tokenId          String?
  metadataUri      String?
  addedAt          DateTime            @default(now())
  submission       Submission          @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  feeShare         FeeShare?

  @@unique([tokenChainId, tokenContract, tokenId])
  @@index([isVisible, displayOrder])
}

model FeeShare {
  id             String           @id @default(cuid())
  galleryEntryId String           @unique
  walletId       String
  basisPoints    Int
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  galleryEntry   GalleryEntry     @relation(fields: [galleryEntryId], references: [id], onDelete: Restrict)
  wallet         Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  accruals       CreatorAccrual[]

  @@index([walletId])
}

model TradeFeeEvent {
  id               String           @id @default(cuid())
  chainId          Int
  txHash           String
  logIndex         Int
  tokenContract    String
  tokenId          String
  currency         String
  currencySymbol   String?
  currencyDecimals Int?
  grossAmount      Decimal          @db.Decimal(78, 0)
  platformFee      Decimal          @db.Decimal(78, 0)
  blockNumber      BigInt
  occurredAt       DateTime?
  indexedAt        DateTime         @default(now())
  accruals         CreatorAccrual[]

  @@unique([chainId, txHash, logIndex])
  @@index([tokenContract, tokenId, blockNumber])
}

model CreatorAccrual {
  id              String        @id @default(cuid())
  tradeFeeEventId String
  feeShareId      String
  amount          Decimal       @db.Decimal(78, 0)
  status          AccrualStatus @default(ACCRUED)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tradeFeeEvent   TradeFeeEvent @relation(fields: [tradeFeeEventId], references: [id], onDelete: Restrict)
  feeShare        FeeShare      @relation(fields: [feeShareId], references: [id], onDelete: Restrict)
  payoutItems     PayoutItem[]

  @@unique([tradeFeeEventId, feeShareId])
  @@index([feeShareId, status])
}

model Payout {
  id               String       @id @default(cuid())
  userId           String
  walletId         String
  chainId          Int
  currency         String
  currencySymbol   String?
  currencyDecimals Int?
  totalAmount      Decimal      @db.Decimal(78, 0)
  status           PayoutStatus @default(PENDING)
  txHash           String?
  failureCode      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet           Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  items            PayoutItem[]

  @@index([userId, status])
}

model PayoutItem {
  payoutId  String
  accrualId String
  payout    Payout         @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  accrual   CreatorAccrual @relation(fields: [accrualId], references: [id], onDelete: Restrict)

  @@id([payoutId, accrualId])
  @@unique([accrualId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  userId       String
  scope        String
  key          String
  requestHash  String
  responseCode Int?
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  before     Json?
  after      Json?
  reason     String?
  requestId  String
  createdAt  DateTime @default(now())
  actor      User     @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
}
